{
  "name": "wissenpur-functions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "lib/entry.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "check:hosting": "tsx scripts/check-hosting-config.ts",
    "check:architecture": "tsx scripts/check-release-architecture.ts",
    "check:content": "tsx scripts/check-content-boundary.ts",
    "sync:questions": "tsx scripts/sync-question-bank.ts",
    "prepare:questions": "npm run check:hosting && npm run check:architecture && npm run check:content && npm run sync:questions",
    "test:typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "test": "npm run test:typecheck && tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run prepare:questions && npm test && npm run typecheck",
    "compile": "tsc",
    "build": "npm run verify && npm run compile",
    "lint": "npm run verify",
    "serve": "npm run build && firebase emulators:start --only auth,functions,firestore",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.0"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
