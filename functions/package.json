{
  "name": "wissenpur-functions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "lib/entry.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "check:secrets": "tsx scripts/check-repository-secrets.ts",
    "check:hosting": "tsx scripts/check-hosting-config.ts",
    "check:architecture": "tsx scripts/check-release-architecture.ts",
    "check:frontend-manifest": "tsx scripts/check-frontend-manifest.ts",
    "check:frontend-lock": "tsx scripts/check-frontend-lockfile.ts",
    "check:account-isolation": "tsx scripts/check-account-isolation.ts",
    "check:ranked-snapshot": "tsx scripts/check-ranked-snapshot.ts",
    "check:callable-rate-limits": "tsx scripts/check-callable-rate-limits.ts",
    "check:pwa-runtime": "tsx scripts/check-pwa-runtime.ts",
    "check:functions-runtime": "tsx scripts/check-functions-runtime.ts",
    "check:learning-library": "tsx scripts/check-learning-library.ts",
    "check:review-queue": "tsx scripts/check-review-queue.ts",
    "check:learning-analytics": "tsx scripts/check-learning-analytics.ts",
    "check:manual-learning-set": "tsx scripts/check-manual-learning-set.ts",
    "check:profile-learning-merge": "tsx scripts/check-profile-learning-merge.ts",
    "check:economy-hydration": "tsx scripts/check-economy-hydration.ts",
    "check:legacy-cleanup": "tsx scripts/check-legacy-cleanup.ts",
    "check:content": "tsx scripts/check-content-boundary.ts",
    "cleanup:legacy": "tsx scripts/cleanup-legacy-release-data.ts",
    "sync:questions": "tsx scripts/sync-question-bank.ts",
    "prepare:questions": "npm run check:secrets && npm run check:hosting && npm run check:architecture && npm run check:frontend-manifest && npm run check:frontend-lock && npm run check:account-isolation && npm run check:ranked-snapshot && npm run check:callable-rate-limits && npm run check:pwa-runtime && npm run check:functions-runtime && npm run check:learning-library && npm run check:review-queue && npm run check:learning-analytics && npm run check:manual-learning-set && npm run check:profile-learning-merge && npm run check:economy-hydration && npm run check:legacy-cleanup && npm run check:content && npm run sync:questions",
    "test:typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "test": "npm run test:typecheck && tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run prepare:questions && npm test && npm run typecheck",
    "compile": "tsc",
    "build": "npm run verify && npm run compile",
    "lint": "npm run verify",
    "serve": "npm run build && firebase emulators:start --only auth,functions,firestore",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.0"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
