# Production: reCAPTCHA Enterprise site key registered with Firebase App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Production uses the stable default Firestore database.
VITE_FIRESTORE_DATABASE_ID=(default)

# Public production URL. HTTPS is mandatory for release builds.
VITE_PUBLIC_APP_URL=https://app.example.com

# Exact Firebase project expected in firebase-applet-config.json. This variable
# is used only by the release checker and is not embedded in the browser bundle.
RELEASE_EXPECTED_FIREBASE_PROJECT_ID=REPLACE_WITH_PRODUCTION_PROJECT_ID

# Production-preflight target. It must match firebase-applet-config.json and
# the explicit projects.production alias in the repository root .firebaserc.
RELEASE_PRODUCTION_FIREBASE_PROJECT_ID=REPLACE_WITH_PRODUCTION_PROJECT_ID

# Exact safety phrase required by npm run preflight:production.
# Example for project wissenpur-prod: PRODUCTION:wissenpur-prod:RELEASE
RELEASE_PRODUCTION_CONFIRMATION=PRODUCTION:REPLACE_WITH_PRODUCTION_PROJECT_ID:RELEASE

# Set true only after the concrete deployment target, default Firestore DB,
# App Check, Functions, AI Logic, quotas, budget alerts and rollback path were reviewed.
RELEASE_DEPLOYMENT_REVIEW_CONFIRMED=false

# Firebase AI Logic production safety. Authenticated-users mode must be enabled
# in the real Firebase project. The configured Generate content per-user RPM
# must be copied here after verification; WissenPur intentionally accepts only
# 1..20 RPM for release because one UI action generates a complete learning set.
RELEASE_AI_AUTHENTICATED_USERS_CONFIRMED=false
RELEASE_AI_RATE_LIMIT_RPM=10

# Set true only after Firebase AI Logic monitoring is active and request count,
# latency, errors and token usage are observable in the real target project.
RELEASE_AI_MONITORING_CONFIRMED=false

# Set true only after budget alerts and the intended spend/cost guardrails for
# the production Firebase/Google Cloud project were reviewed and activated.
RELEASE_BUDGET_GUARDS_CONFIRMED=false

# Confirm only after Firestore TTL policies are active for both short-lived
# collections in the real production project. The value is intentionally exact.
RELEASE_FIRESTORE_TTL_CONFIRMATION=quizSessions.expiresAt,serverRateLimits.expiresAt

# Hosting rollback planning. `rollback:plan` only prints commands and never
# executes Firebase operations. Site must be entered twice and channel must
# start with rollback-. Phrase: ROLLBACK:<PROJECT>:<SITE>:<CHANNEL>
RELEASE_HOSTING_SITE=
RELEASE_HOSTING_SITE_CONFIRMATION=
RELEASE_HOSTING_ROLLBACK_CHANNEL=rollback-before-release
RELEASE_HOSTING_ROLLBACK_CONFIRMATION=

# Firestore named-database -> (default) migration planning. The planner only
# prints Managed Export/Import commands. Source must be entered twice, the GCS
# destination must live below /wissenpur-migration/, and an intentionally empty
# (default) target must be confirmed before an import plan is produced.
RELEASE_FIRESTORE_SOURCE_DATABASE_ID=
RELEASE_FIRESTORE_SOURCE_DATABASE_CONFIRMATION=
RELEASE_FIRESTORE_MIGRATION_GCS_PATH=gs://REPLACE_WITH_BUCKET/wissenpur-migration/REPLACE_WITH_SNAPSHOT
RELEASE_FIRESTORE_DEFAULT_EMPTY_CONFIRMED=false
# Phrase: MIGRATE:<PROJECT>:<SOURCE_DATABASE>:(default)
RELEASE_FIRESTORE_MIGRATION_CONFIRMATION=

# Set true only after project ownership, Blaze billing, quotas, App Check,
# regions, budget alerts and the embedded Web App configuration were reviewed.
RELEASE_FIREBASE_PROJECT_REVIEW_CONFIRMED=false

# Public operator and contact information used by the legal screens.
VITE_LEGAL_OPERATOR_NAME=REPLACE_WITH_REAL_OPERATOR
VITE_LEGAL_STREET=REPLACE_WITH_STREET_AND_NUMBER
VITE_LEGAL_POSTAL_CITY=REPLACE_WITH_POSTAL_CODE_AND_CITY
VITE_LEGAL_COUNTRY=Deutschland
VITE_LEGAL_EMAIL=legal@example.com
VITE_PRIVACY_EMAIL=privacy@example.com
VITE_SUPPORT_EMAIL=support@example.com
VITE_LEGAL_EFFECTIVE_DATE=2026-08-06

# Must be deliberately selected after reviewing the target audience and law.
VITE_MINIMUM_AGE=16

# Retention periods shown in the public privacy information.
VITE_LOG_RETENTION_DAYS=30
VITE_SESSION_RETENTION_DAYS=30
VITE_SUPPORT_RETENTION_DAYS=180

# Set true only after the real operator data and generated legal texts have
# been reviewed for the intended countries and target audience.
VITE_LEGAL_REVIEW_CONFIRMED=false

# Local development only. When true, Firebase prints an App Check debug token
# that must be allowlisted in the Firebase console. Never enable in production.
VITE_ENABLE_APPCHECK_DEBUG=false

# Local development only. Routes callable requests to the Firebase Functions
# emulator on 127.0.0.1:5001.
VITE_USE_FUNCTIONS_EMULATOR=false
