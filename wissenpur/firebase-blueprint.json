{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user statistics and profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique ID of the user." },
        "displayName": { "type": "string", "description": "The display name of the user." },
        "photoURL": { "type": "string", "description": "The URL of the user's profile picture." },
        "totalPoints": { "type": "integer", "description": "Total points earned by the user." },
        "currentStreak": { "type": "integer", "description": "Current daily streak." },
        "bestStreak": { "type": "integer", "description": "Best daily streak achieved." },
        "roundsPlayed": { "type": "integer", "description": "Total quiz rounds played." },
        "correctAnswers": { "type": "integer", "description": "Total correct answers." },
        "totalQuestionsAnswered": { "type": "integer", "description": "Total questions attempted." },
        "lastPlayedDate": { "type": "string", "format": "date", "description": "The last date the user played." },
        "achievements": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of unlocked achievement IDs."
        }
      },
      "required": ["uid", "totalPoints", "currentStreak", "bestStreak", "roundsPlayed", "correctAnswers", "totalQuestionsAnswered"]
    },
    "LeaderboardEntry": {
      "title": "Leaderboard Entry",
      "description": "A denormalized entry for the global leaderboard.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "totalPoints": { "type": "integer" },
        "rank": { "type": "integer" }
      },
      "required": ["uid", "displayName", "totalPoints"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profile data."
    },
    "/leaderboard/{userId}": {
      "schema": "LeaderboardEntry",
      "description": "Publicly visible leaderboard data."
    }
  }
}
