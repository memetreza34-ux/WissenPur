rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function hasValidOptionalString(data, field, maxLength) {
      return !(field in data) ||
             (data[field] is string && data[field].size() <= maxLength);
    }

    function hasValidOptionalList(data, field, maxItems) {
      return !(field in data) ||
             (data[field] is list && data[field].size() <= maxItems);
    }

    function hasValidOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function hasValidOptionalAge(data) {
      return !('age' in data) ||
             (data.age is int && data.age >= 0 && data.age <= 120);
    }

    function isValidDifficultyTime(value) {
      return value is int && value >= 5 && value <= 120;
    }

    function hasValidOptionalDifficultyTimes(data) {
      return !('customDifficultyTimes' in data) ||
             (
               data.customDifficultyTimes is map &&
               data.customDifficultyTimes.keys().hasOnly([
                 'leicht',
                 'mittel',
                 'schwer',
                 'all'
               ]) &&
               (!('leicht' in data.customDifficultyTimes) || isValidDifficultyTime(data.customDifficultyTimes.leicht)) &&
               (!('mittel' in data.customDifficultyTimes) || isValidDifficultyTime(data.customDifficultyTimes.mittel)) &&
               (!('schwer' in data.customDifficultyTimes) || isValidDifficultyTime(data.customDifficultyTimes.schwer)) &&
               (!('all' in data.customDifficultyTimes) || isValidDifficultyTime(data.customDifficultyTimes.all))
             );
    }

    function hasValidLearningPlan(data) {
      return !('learningPlan' in data) ||
             data.learningPlan == null ||
             (
               data.learningPlan is map &&
               data.learningPlan.keys().hasOnly([
                 'version',
                 'examTitle',
                 'examDate',
                 'category',
                 'dailyMinutes',
                 'weeklyDays',
                 'createdAt',
                 'updatedAt',
                 'completedSessions',
                 'lastCompletedDate'
               ]) &&
               data.learningPlan.version == 1 &&
               data.learningPlan.examTitle is string &&
               data.learningPlan.examTitle.size() > 0 &&
               data.learningPlan.examTitle.size() <= 100 &&
               data.learningPlan.examDate is string &&
               data.learningPlan.examDate.size() == 10 &&
               data.learningPlan.category is string &&
               data.learningPlan.category.size() > 0 &&
               data.learningPlan.category.size() <= 50 &&
               data.learningPlan.dailyMinutes is int &&
               (
                 data.learningPlan.dailyMinutes == 10 ||
                 data.learningPlan.dailyMinutes == 20 ||
                 data.learningPlan.dailyMinutes == 30 ||
                 data.learningPlan.dailyMinutes == 45
               ) &&
               data.learningPlan.weeklyDays is int &&
               data.learningPlan.weeklyDays >= 3 &&
               data.learningPlan.weeklyDays <= 7 &&
               data.learningPlan.createdAt is int &&
               data.learningPlan.createdAt >= 0 &&
               data.learningPlan.updatedAt is int &&
               data.learningPlan.updatedAt >= data.learningPlan.createdAt &&
               data.learningPlan.completedSessions is int &&
               data.learningPlan.completedSessions >= 0 &&
               (
                 data.learningPlan.lastCompletedDate == null ||
                 (
                   data.learningPlan.lastCompletedDate is string &&
                   data.learningPlan.lastCompletedDate.size() == 10
                 )
               )
             );
    }

    function isValidClientProfile(userId, data) {
      return data.uid == userId &&
             data.uid is string &&
             hasValidOptionalString(data, 'displayName', 100) &&
             hasValidOptionalString(data, 'customName', 100) &&
             hasValidOptionalString(data, 'photoURL', 1000) &&
             hasValidOptionalAge(data) &&
             hasValidOptionalList(data, 'wrongQuestions', 300) &&
             hasValidOptionalDifficultyTimes(data) &&
             hasValidOptionalBool(data, 'darkMode') &&
             hasValidOptionalList(data, 'customQuizzes', 100) &&
             hasValidLearningPlan(data);
    }

    function clientProfileKeys() {
      return [
        'uid',
        'displayName',
        'customName',
        'age',
        'photoURL',
        'wrongQuestions',
        'customDifficultyTimes',
        'darkMode',
        'customQuizzes',
        'learningPlan'
      ];
    }

    function changesOnlyProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'customName',
        'age',
        'photoURL',
        'wrongQuestions',
        'customDifficultyTimes',
        'darkMode',
        'customQuizzes',
        'learningPlan'
      ]);
    }

    function isValidTrustedLeaderboard(userId, data) {
      return data.keys().hasOnly([
               'uid',
               'displayName',
               'photoURL',
               'totalPoints',
               'economyVersion',
               'updatedAt'
             ]) &&
             data.keys().hasAll([
               'uid',
               'displayName',
               'photoURL',
               'totalPoints',
               'economyVersion'
             ]) &&
             data.uid is string &&
             data.uid == userId &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 100 &&
             data.photoURL is string &&
             data.photoURL.size() <= 1000 &&
             (
               data.photoURL == '' ||
               data.photoURL.matches('^/avatars/[A-Za-z0-9-]+[.]svg$')
             ) &&
             data.totalPoints is int &&
             data.totalPoints >= 0 &&
             data.totalPoints <= 100000000 &&
             data.economyVersion == 1 &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // New browser-created documents contain profile and learning content
      // only. Economy fields, inventory and shop avatars are added exclusively
      // by Cloud Functions.
      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasOnly(clientProfileKeys()) &&
                       isValidClientProfile(userId, request.resource.data);

      allow update: if isOwner(userId) &&
                       changesOnlyProfileFields() &&
                       isValidClientProfile(userId, request.resource.data);

      allow delete: if isAdmin();
    }

    // Browser collection enumeration is disabled. Public ranked lists are
    // served by the App-Check-protected getTrustedLeaderboard callable, which
    // sanitizes every returned row. A direct single-document read remains
    // available only for a minimal valid display profile.
    match /trustedLeaderboard/{userId} {
      allow get: if isValidTrustedLeaderboard(userId, resource.data);
      allow list: if false;
      allow write: if false;
    }

    // Historical client-writable leaderboard. It is hidden from release
    // clients and retained only until the one-time cleanup is complete.
    match /leaderboard/{userId} {
      allow read, write: if isAdmin();
    }

    // Trusted scoring state and immutable answer snapshots are never exposed
    // through the Firestore browser SDK.
    match /quizSessions/{sessionId} {
      allow read, write: if false;
    }

    match /serverRateLimits/{userId} {
      allow read, write: if false;
    }

    // Multiplayer remains disabled until a new server-authoritative model is
    // implemented. Old data is admin-only during cleanup.
    match /lobbies/{lobbyId} {
      allow read, write: if isAdmin();
    }

    match /duels/{duelId} {
      allow read, write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
