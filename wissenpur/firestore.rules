rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function hasValidOptionalString(data, field, maxLength) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLength);
    }

    function hasValidOptionalList(data, field, maxItems) {
      return !(field in data) || (data[field] is list && data[field].size() <= maxItems);
    }

    function hasServerEconomy(data) {
      return ('economyVersion' in data) && data.economyVersion == 1;
    }

    function isValidUser(userId, data) {
      return data.uid == userId &&
             data.uid is string &&
             (!('economyVersion' in data) || data.economyVersion == 1) &&
             data.totalPoints is int && data.totalPoints >= 0 && data.totalPoints <= 10000000 &&
             data.coins is int && data.coins >= 0 && data.coins <= 1000000 &&
             data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000 &&
             data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 10000 &&
             data.roundsPlayed is int && data.roundsPlayed >= 0 && data.roundsPlayed <= 1000000 &&
             data.correctAnswers is int && data.correctAnswers >= 0 && data.correctAnswers <= 100000000 &&
             data.totalQuestionsAnswered is int && data.totalQuestionsAnswered >= 0 && data.totalQuestionsAnswered <= 100000000 &&
             hasValidOptionalString(data, 'displayName', 100) &&
             hasValidOptionalString(data, 'customName', 100) &&
             hasValidOptionalString(data, 'photoURL', 1000) &&
             hasValidOptionalString(data, 'customPhotoURL', 350000) &&
             hasValidOptionalList(data, 'achievements', 100) &&
             hasValidOptionalList(data, 'wrongQuestions', 300) &&
             hasValidOptionalList(data, 'customQuizzes', 100);
    }

    function keepsCumulativeProgress(data) {
      return data.totalPoints >= resource.data.totalPoints &&
             data.roundsPlayed >= resource.data.roundsPlayed &&
             data.correctAnswers >= resource.data.correctAnswers &&
             data.totalQuestionsAnswered >= resource.data.totalQuestionsAnswered &&
             data.bestStreak >= resource.data.bestStreak;
    }

    function changesOnlyProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'customName',
        'age',
        'photoURL',
        'customPhotoURL',
        'wrongQuestions',
        'customDifficultyTimes',
        'darkMode',
        'customQuizzes'
      ]);
    }

    function isValidLeaderboardEntry(userId, data) {
      return data.uid == userId &&
             data.uid is string &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.totalPoints is int && data.totalPoints >= 0 && data.totalPoints <= 10000000 &&
             hasValidOptionalString(data, 'photoURL', 1000) &&
             exists(/databases/$(database)/documents/users/$(userId)) &&
             data.totalPoints == get(/databases/$(database)/documents/users/$(userId)).data.totalPoints;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Legacy documents may be created by the current client during the
      // transition. Clients can never mark their own balance as trusted.
      allow create: if isOwner(userId) &&
                       !('economyVersion' in request.resource.data) &&
                       isValidUser(userId, request.resource.data);

      allow update: if isOwner(userId) &&
                       isValidUser(userId, request.resource.data) &&
                       (
                         (hasServerEconomy(resource.data) && changesOnlyProfileFields()) ||
                         (!hasServerEconomy(resource.data) &&
                          !('economyVersion' in request.resource.data) &&
                          keepsCumulativeProgress(request.resource.data))
                       );

      allow delete: if isAdmin();
    }

    match /leaderboard/{userId} {
      allow read: if true;

      // Once Cloud Functions migrates a user to economyVersion 1, only trusted
      // server code may update that user's leaderboard entry.
      allow create, update: if isOwner(userId) &&
                               exists(/databases/$(database)/documents/users/$(userId)) &&
                               !hasServerEconomy(get(/databases/$(database)/documents/users/$(userId)).data) &&
                               isValidLeaderboardEntry(userId, request.resource.data);
      allow delete: if isAdmin();
    }

    // Quiz sessions contain trusted scoring state and are never readable or
    // writable from the browser. Callable Functions use the Admin SDK and
    // bypass these client rules.
    match /quizSessions/{sessionId} {
      allow read, write: if false;
    }

    // Multiplayer is not yet server-authoritative. Client writes stay disabled
    // until lobby membership, score calculation, reconnects and match results
    // are validated by trusted backend code.
    match /lobbies/{lobbyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /duels/{duelId} {
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.player1Uid ||
                      request.auth.uid == resource.data.player2Uid ||
                      isAdmin());
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
